diff --git a/src/plugins/screencast/windowscreencastsource.cpp b/src/plugins/screencast/windowscreencastsource.cpp
index f1ec191..7124436 100644
--- a/src/plugins/screencast/windowscreencastsource.cpp
+++ b/src/plugins/screencast/windowscreencastsource.cpp
@@ -208,6 +208,33 @@ RectF WindowScreenCastSource::boundingRect() const
     return boundingRect;
 }
 
+QMap<QByteArray, QByteArray> WindowScreenCastSource::metadata() const
+{
+    if (m_windows.isEmpty()) {
+        return {};
+    }
+
+    // The first window is the one that was requested; the rest are transients
+    // pulled in alongside it, and they belong to the same application anyway.
+    const Window *window = m_windows.constFirst();
+
+    QMap<QByteArray, QByteArray> data{
+        {"kwin.screencast.source-type", "window"},
+        {"kwin.window.uuid", window->internalId().toString(QUuid::WithoutBraces).toUtf8()},
+        {"kwin.window.resource-class", window->resourceClass().toUtf8()},
+        {"kwin.window.resource-name", window->resourceName().toUtf8()},
+        {"kwin.window.desktop-file", window->desktopFileName().toUtf8()},
+        {"kwin.window.caption", window->caption().toUtf8()},
+    };
+
+    // X11 windows report -1 when _NET_WM_PID is unset.
+    if (const pid_t pid = window->pid(); pid > 0) {
+        data.insert("kwin.window.pid", QByteArray::number(pid));
+    }
+
+    return data;
+}
+
 } // namespace KWin
 
