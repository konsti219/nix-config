@@ -411,7 +411,22 @@ uint64_t ScreenCastStream::objectSerial() const
 bool ScreenCastStream::createStream()
 {
     const QByteArray objname = "kwin-screencast-" + objectName().toUtf8();
-    m_pwStream = pw_stream_new(m_pwCore->pwCore, objname, nullptr);
+
+    // Describe what is being captured. Deliberately additive: no standard key is
+    // set here, so the node keeps the media.class and name it has always had.
+    pw_properties *props = nullptr;
+    const QMap<QByteArray, QByteArray> metadata = m_source->metadata();
+    if (!metadata.isEmpty()) {
+        props = pw_properties_new(nullptr, nullptr);
+        for (auto it = metadata.cbegin(); it != metadata.cend(); ++it) {
+            if (!it.value().isEmpty()) {
+                pw_properties_set(props, it.key().constData(), it.value().constData());
+            }
+        }
+    }
+
+    // Takes ownership of props, including when it is null.
+    m_pwStream = pw_stream_new(m_pwCore->pwCore, objname, props);
 
